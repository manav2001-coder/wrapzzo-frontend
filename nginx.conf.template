server {
    listen ${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Compress text on the way out -- the JS bundle is the bulk of what every visitor downloads.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/css application/javascript text/javascript application/json image/svg+xml text/plain;

    # Vite names built files by their content (assets/index-3f9a1c.js), so a file at a given name never
    # changes: browsers and any CDN in front may keep it for a year. A name that does not exist is a
    # real 404 -- never index.html, which would be cached for a year under a JS file's name.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The page that points at those files must be re-checked on every visit, or a deploy is not seen.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # The icons and favicon keep their names across deploys: a day, then re-check.
    location ~* \.(svg|ico|png|webp)$ {
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    # SPA fallback -- React Router owns client-side routes, so any path
    # that isn't a real static file should still serve index.html.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
