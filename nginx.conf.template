# The request as the browser sent it, minus the /storage prefix: path and query, still percent-encoded exactly as signed.
map $request_uri $storage_uri {
    ~^/storage(?<rest>/.*)$ $rest;
    default "";
}

server {
    listen ${PORT};
    server_name _;

    resolver ${DNS_RESOLVER} valid=30s ipv6=off;

    root /usr/share/nginx/html;
    index index.html;

    # Compress text on the way out -- the JS bundle is the bulk of what every visitor downloads.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_types text/css application/javascript text/javascript application/json image/svg+xml text/plain;

    # Vite names built files by their content (assets/index-3f9a1c.js), so a file at a given name never
    # changes: browsers and any CDN in front may keep it for a year. A name that does not exist is a
    # real 404 -- never index.html, which would be cached for a year under a JS file's name.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # The backend, under the app's own address. The browser only ever talks to this host: an office network that
    # blocks the backend's own address (a generic hosting domain, which firewalls often do) cannot then break sign-in.
    # API_UPSTREAM and DNS_RESOLVER come from the environment (defaults in the Dockerfile). Because the upstream is a
    # variable, nginx looks it up at request time through `resolver`, and passes the request path on unchanged.
    location /api/ {
        set $upstream ${API_UPSTREAM};
        proxy_pass $upstream;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Connection "";
        # Bulk uploads of users and doctors are large JSON bodies, and imports can take a while to answer.
        client_max_body_size 25m;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        add_header Cache-Control "no-store";
    }

    # Photo and proof uploads, under the app's own address. The browser PUTs to a signed storage URL, and some phone networks
    # and office firewalls block the storage host (r2.cloudflarestorage.com) while letting the app load, so the upload died
    # with "Failed to fetch". The page rewrites the storage URL to /storage/... and this forwards it, unchanged, to storage.
    # The signature covers the path, query and Host, so none of them is altered: only the /storage prefix is dropped (byte for
    # byte, encoding included), and Host is the storage host. STORAGE_UPSTREAM comes from the environment (default in the Dockerfile).
    location /storage/ {
        # proxy_pass with the raw path and query ($storage_uri, below): `rewrite` would decode and re-encode the path (%2B -> +),
        # which changes what was signed.
        proxy_pass ${STORAGE_UPSTREAM}$storage_uri;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Host $proxy_host;
        proxy_set_header Connection "";
        # Photos are a few MB, but a phone camera can make 20 MB; stream them through rather than hold them in memory.
        client_max_body_size 50m;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        add_header Cache-Control "no-store";
    }

    # The page that points at those files must be re-checked on every visit, or a deploy is not seen.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # The icons and favicon keep their names across deploys: a day, then re-check.
    location ~* \.(svg|ico|png|webp)$ {
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    # SPA fallback -- React Router owns client-side routes, so any path
    # that isn't a real static file should still serve index.html.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
